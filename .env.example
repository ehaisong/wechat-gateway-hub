# ====== 微信开放平台「网站应用」凭据(PC 扫码登录,scope=snsapi_login)======
# 用于微信外浏览器:在 https://open.weixin.qq.com 创建网站应用
WECHAT_APPID=wxxxxxxxxxxxxxxxx
WECHAT_APPSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ====== 微信「公众号(认证服务号)」凭据(微信内 H5 网页授权,scope=snsapi_userinfo)======
# 用于微信内置浏览器:在公众号后台「基本配置」获取,
# 并在「设置与开发 -> 公众号设置 -> 功能设置 -> 网页授权域名」配置本服务域名
WECHAT_MP_APPID=wxxxxxxxxxxxxxxxx
WECHAT_MP_APPSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ====== 本中转站对外的基础 URL(必填)======
# 必须 https,不要带末尾斜杠;同时是网站应用「授权回调域」与公众号「网页授权域名」
RELAY_BASE_URL=https://wx.lovclaw.com

# ====== 业务站点白名单(必填,JSON 字符串)======
# 每个 client 的 client_secret 至少 16 个字符,只发给该业务站点的后端持有
CLIENTS_JSON={"a":{"origin":"https://a.com","done_path":"/login/wechat-done","client_secret":"replace-with-long-random-string-1"}}

# ====== 端口(可选,默认 3000)======
PORT=3000

# ====== 阿里云短信服务 (用于手机号验证码登录) ======
# 控制台 https://dysms.console.aliyun.com 创建 RAM 子账号 + 短信签名 + 模板
ALIYUN_SMS_ACCESS_KEY_ID=LTAIxxxxxxxxxxxx
ALIYUN_SMS_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALIYUN_SMS_SIGN_NAME=轻爪科技
ALIYUN_SMS_TEMPLATE_CODE=SMS_123456789
ALIYUN_SMS_REGION=cn-hangzhou

# ====== 分享二维码跳转域名池 (GET /r 使用) ======
# domains 列表 + isPrimary 决定 active 主域名；enabled=false 的域名会被忽略
SHARE_DOMAINS_JSON={"domains":[{"domain":"66cai.site","enabled":true,"isPrimary":true},{"domain":"cai123.lovable.app","enabled":true,"isPrimary":false}]}
