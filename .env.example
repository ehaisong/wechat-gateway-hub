# ====== 微信开放平台网站应用凭据(必填)======
# 在 https://open.weixin.qq.com 创建网站应用并通过审核后获得
WECHAT_APPID=wxxxxxxxxxxxxxxxx
WECHAT_APPSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ====== 本中转站对外的基础 URL(必填)======
# 必须与微信开放平台「授权回调域」匹配,必须 https,不要带末尾斜杠
RELAY_BASE_URL=https://b.com

# ====== 业务站点白名单(必填,JSON 字符串)======
# 每个 client 的 client_secret 至少 16 个字符,只发给该业务站点的后端持有
CLIENTS_JSON={"a":{"origin":"https://a.com","done_path":"/login/wechat-done","client_secret":"replace-with-long-random-string-1"},"c":{"origin":"https://c.com","done_path":"/login/wechat-done","client_secret":"replace-with-long-random-string-2"},"d":{"origin":"https://d.com","done_path":"/login/wechat-done","client_secret":"replace-with-long-random-string-3"}}

# ====== 端口(可选,默认 3000)======
PORT=3000
